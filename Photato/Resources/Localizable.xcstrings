    "• After the free trial ends, your subscription automatically renews unless canceled at least 24 hours before it ends." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• After the free trial ends, your subscription automatically renews unless canceled at least 24 hours before it ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Al terminar la prueba gratuita, la suscripción se renovará automáticamente, salvo que la canceles al menos 24 horas antes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 無料トライアル終了後は、終了の24時間以上前に解約しない限り自動的に更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 무료 체험 종료 후 종료 최소 24시간 전에 취소하지 않으면 구독이 자동 갱신됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Após o teste grátis, a assinatura é renovada automaticamente, exceto se cancelada com pelo menos 24 horas de antecedência."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 免费试用结束后，订阅将自动续订，除非在试用结束前至少 24 小时取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 免費試用結束後，訂閱將自動續訂，除非在試用結束前至少 24 小時取消。"
          }
        }
      }
    },
    "• Subscription will auto-renew unless turned off at least 24 hours before the current period ends." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Subscription will auto-renew unless turned off at least 24 hours before the current period ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• La suscripción se renueva automáticamente salvo que se desactive al menos 24 horas antes del final del periodo actual."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 現在の期間終了の24時間以上前にオフにしない限り、サブスクリプションは自動更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 현재 기간 종료 최소 24시간 전에 해지하지 않으면 구독이 자동 갱신됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• A assinatura renova automaticamente, exceto se desativada com pelo menos 24 horas de antecedência ao fim do período atual."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 订阅将自动续订，除非在当前期间结束前至少 24 小时关闭自动续订"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 訂閱將自動續訂，除非在當前期間結束前至少 24 小時關閉自動續訂"
          }
        }
      }
    },
    "• You can manage your subscription and turn off auto-renewal after purchase." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• You can manage your subscription and turn off auto-renewal after purchase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Puedes gestionar tu suscripción y desactivar la renovación automática después de la compra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 購入後にサブスクリプションを管理し、自動更新をオフにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 구매 후 구독을 관리하고 자동 갱신을 끌 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Após a compra, você pode gerenciar a assinatura e desativar a renovação automática."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 用户可以管理订阅，购买后可以关闭自动续订"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 使用者可以管理訂閱，購買後可以關閉自動續訂"
          }
        }
      }
    },
    "• Your account will be charged for renewal within 24 hours before the current period ends." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Your account will be charged for renewal within 24 hours before the current period ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Tu cuenta se cargará con el importe de la renovación en las 24 horas previas al final del periodo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 期間終了の24時間前以内に、更新料金がアカウントに請求されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 기간 종료 24시간 전에 갱신 요금이 계정으로 청구됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Sua conta será cobrada pela renovação nas 24 horas antes do fim do período."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 账户将在当前期间结束前 24 小时内收取续订费用"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 賬戶將在當前期間結束前 24 小時內收取續訂費用"
          }
        }
      }
    },
