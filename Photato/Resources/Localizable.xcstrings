    "%lld photos will be moved to the Trash and can be restored there. Total %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld photos will be moved to Pending Photos and can be restored there. Total %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld fotos se moverán a Pendientes y podrán restaurarse desde allí. Total: %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld枚の写真が削除待ちに移動され、そこから復元できます。合計%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 %1$lld장이 삭제 대기로 이동되며 복원할 수 있습니다. 총 %2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld fotos serão movidas para as pendentes e poderão ser restauradas de lá. Total: %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 张照片将移入待处理照片，可随时恢复，共 %@"
