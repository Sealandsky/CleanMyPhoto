      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organizing and moving photos here is free. Permanently deleting requires Photato Pro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
