    "purchase_disclosure_no_trial" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@ will be charged on confirmation. Renews automatically. Cancel anytime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cobrará %1$@%2$@ al confirmar. Se renueva automáticamente. Cancela cuando quieras."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認後に%1$@%2$@が請求されます。自動更新されます。いつでも解約できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인 시 %1$@%2$@이(가) 청구됩니다. 자동으로 갱신되며 언제든 해지할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Será cobrado %1$@%2$@ na confirmação. Renova automaticamente. Cancele quando quiser."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确认后即收取 %1$@%2$@，自动续订，可随时取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認後即收取 %1$@%2$@，自動續訂，可隨時取消。"
          }
        }
      }
    },
    "purchase_disclosure_trial" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@; after the trial ends, %2$@%3$@ is charged automatically. Cancel anytime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@; al terminar la prueba se cobrará %2$@%3$@ automáticamente. Cancela cuando quieras."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@。トライアル終了後は%2$@%3$@が自動請求されます。いつでも解約できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@. 체험 종료 후 %2$@%3$@이(가) 자동 청구됩니다. 언제든 해지할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@; após o teste, %2$@%3$@ será cobrado automaticamente. Cancele quando quiser."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@，试用结束后将自动收取 %2$@%3$@，可随时取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@，試用結束後將自動收取 %2$@%3$@，可隨時取消。"
          }
        }
      }
    },
