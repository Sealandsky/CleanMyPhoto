    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photato needs permission to save photos to your library."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图豆需要保存照片至图库的权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圖豆需要儲存照片至相簿的許可權。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真ライブラリに写真を保存するためにアクセス許可が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진을 보관함에 저장하기 위해 접근 권한이 필요합니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita permiso para guardar fotos en tu fototeca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É necessária permissão para salvar fotos na sua fototeca."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photato needs access to your photo library to help you organize and delete unwanted photos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图豆需要访问您的照片图库，以帮助您整理并清理无用照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圖豆需要訪問您的照片相簿，以幫助您整理並清理無用照片。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要な写真を整理・削除するために、写真ライブラリへのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원치 않는 사진을 정리하고 삭제하기 위해 사진 보관함 접근 권한이 필요합니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta app necesita acceso a tu fototeca para ayudarte a organizar y eliminar fotos no deseadas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este app precisa de acesso à sua fototeca para ajudar você a organizar e excluir fotos indesejadas."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
